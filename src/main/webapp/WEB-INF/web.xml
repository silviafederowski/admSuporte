<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>admSuporte</display-name>

    <!-- Dominios autorizados a servir esta aplicacao (Host da requisicao). -->
    <context-param>
        <param-name>allowedHosts</param-name>
        <param-value>silsys.com.br,www.silsys.com.br</param-value>
    </context-param>

    <listener>
        <listener-class>br.com.silsys.admsuporte.listener.AppInitListener</listener-class>
    </listener>

    <!--
      Precisa ser o primeiro filtro: forca UTF-8 na leitura dos parametros antes de
      qualquer request.getParameter(...), senao o container decodifica como ISO-8859-1
      e corrompe acentos.
    -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>br.com.silsys.admsuporte.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>DomainRestrictionFilter</filter-name>
        <filter-class>br.com.silsys.admsuporte.filter.DomainRestrictionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>DomainRestrictionFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>br.com.silsys.admsuporte.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/menu</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/alerta-servicos</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/placeholder</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/google-form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/google-form/upload</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/google-form/pdf</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/logout</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/register</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/prestadores</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/prestadores/form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/prestadores/excluir</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/servicos</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/servicos/form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/servicos/excluir</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/operacoes</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/fornecedores</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/fornecedores/form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/fornecedores/excluir</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/produtos</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/produtos/form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/produtos/excluir</url-pattern>
    </filter-mapping>

    <!--
      Restringe acoes de escrita (criar/editar/excluir) a administrador/zelador (nivel <= 9).
      As telas de consulta (/prestadores, /servicos) ficam liberadas a qualquer usuario logado,
      protegidas so pelo AuthFilter.
    -->
    <filter>
        <filter-name>AdminOrZeladorFilter</filter-name>
        <filter-class>br.com.silsys.admsuporte.filter.AdminOrZeladorFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminOrZeladorFilter</filter-name>
        <url-pattern>/register</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminOrZeladorFilter</filter-name>
        <url-pattern>/google-form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminOrZeladorFilter</filter-name>
        <url-pattern>/google-form/upload</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminOrZeladorFilter</filter-name>
        <url-pattern>/google-form/pdf</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminOrZeladorFilter</filter-name>
        <url-pattern>/operacoes</url-pattern>
    </filter-mapping>

    <!--
      Telas de formulario dos cadastros (prestadores/fornecedores/servicos/produtos):
      qualquer usuario logado pode consultar (GET); so administrador/zelador (nivel <= 9)
      pode gravar (POST, salvar ou excluir).
    -->
    <filter>
        <filter-name>EscritaRestritaFilter</filter-name>
        <filter-class>br.com.silsys.admsuporte.filter.EscritaRestritaFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EscritaRestritaFilter</filter-name>
        <url-pattern>/prestadores/form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>EscritaRestritaFilter</filter-name>
        <url-pattern>/prestadores/excluir</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>EscritaRestritaFilter</filter-name>
        <url-pattern>/servicos/form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>EscritaRestritaFilter</filter-name>
        <url-pattern>/servicos/excluir</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>EscritaRestritaFilter</filter-name>
        <url-pattern>/fornecedores/form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>EscritaRestritaFilter</filter-name>
        <url-pattern>/fornecedores/excluir</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>EscritaRestritaFilter</filter-name>
        <url-pattern>/produtos/form</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>EscritaRestritaFilter</filter-name>
        <url-pattern>/produtos/excluir</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PrestadorServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.PrestadorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrestadorServlet</servlet-name>
        <url-pattern>/prestadores</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PrestadorFormServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.PrestadorFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrestadorFormServlet</servlet-name>
        <url-pattern>/prestadores/form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PrestadorDeleteServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.PrestadorDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrestadorDeleteServlet</servlet-name>
        <url-pattern>/prestadores/excluir</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ServicoServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.ServicoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServicoServlet</servlet-name>
        <url-pattern>/servicos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ServicoFormServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.ServicoFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServicoFormServlet</servlet-name>
        <url-pattern>/servicos/form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ServicoDeleteServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.ServicoDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServicoDeleteServlet</servlet-name>
        <url-pattern>/servicos/excluir</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OperacoesLogServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.OperacoesLogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OperacoesLogServlet</servlet-name>
        <url-pattern>/operacoes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FornecedorServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.FornecedorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FornecedorServlet</servlet-name>
        <url-pattern>/fornecedores</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FornecedorFormServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.FornecedorFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FornecedorFormServlet</servlet-name>
        <url-pattern>/fornecedores/form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FornecedorDeleteServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.FornecedorDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FornecedorDeleteServlet</servlet-name>
        <url-pattern>/fornecedores/excluir</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProdutoServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.ProdutoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProdutoServlet</servlet-name>
        <url-pattern>/produtos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProdutoFormServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.ProdutoFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProdutoFormServlet</servlet-name>
        <url-pattern>/produtos/form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProdutoDeleteServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.ProdutoDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProdutoDeleteServlet</servlet-name>
        <url-pattern>/produtos/excluir</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.ResetPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AlertaServicosServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.AlertaServicosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AlertaServicosServlet</servlet-name>
        <url-pattern>/alerta-servicos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MenuServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.MenuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MenuServlet</servlet-name>
        <url-pattern>/menu</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PlaceholderServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.PlaceholderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlaceholderServlet</servlet-name>
        <url-pattern>/placeholder</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoogleFormServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.GoogleFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoogleFormServlet</servlet-name>
        <url-pattern>/google-form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoogleFormUploadServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.GoogleFormUploadServlet</servlet-class>
        <multipart-config>
            <max-file-size>20971520</max-file-size>
            <max-request-size>26214400</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoogleFormUploadServlet</servlet-name>
        <url-pattern>/google-form/upload</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoogleFormPdfServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.GoogleFormPdfServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoogleFormPdfServlet</servlet-name>
        <url-pattern>/google-form/pdf</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoServlet</servlet-name>
        <servlet-class>br.com.silsys.admsuporte.servlet.LogoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoServlet</servlet-name>
        <url-pattern>/logo</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/error403.jsp</location>
    </error-page>

</web-app>
